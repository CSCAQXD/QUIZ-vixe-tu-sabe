{
  "name": "quiz-vixe-tu-sabe",
  "version": "1.0.0",
  "private": true,
  "description": "Atalhos para desenvolvimento e testes do Quiz Vixe, Tu Sabe?",
  "scripts": {
    "prepare": "husky",
    "dev": "node scripts/workspace-runner.cjs dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:all": "node scripts/workspace-runner.cjs dev all",
    "start": "node scripts/workspace-runner.cjs start",
    "start:backend": "npm --prefix backend run start",
    "preview:frontend": "npm --prefix frontend run preview",
    "test": "node scripts/workspace-runner.cjs test",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "test:all": "node scripts/workspace-runner.cjs test all",
    "test:coverage": "node scripts/workspace-runner.cjs test:coverage",
    "coverage:backend": "npm --prefix backend run test:coverage",
    "coverage:frontend": "npm --prefix frontend run test:coverage",
    "coverage:all": "node scripts/workspace-runner.cjs test:coverage all",
    "build": "node scripts/workspace-runner.cjs build",
    "build:frontend": "npm --prefix frontend run build",
    "lint": "node scripts/workspace-runner.cjs lint",
    "lint:all": "npm run lint:backend && npm run lint:frontend",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint:backend": "npm --prefix backend run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:all": "npm audit --audit-level=high && npm audit --audit-level=high --prefix backend && npm audit --audit-level=high --prefix frontend",
    "backup:database": "node backend/scripts/backupDatabase.js",
    "restore:database": "node backend/scripts/restoreDatabase.js",
    "quality": "npm run format:check && npm run lint:all && npm run check:backend && npm run coverage:all && npm run build",
    "check:backend": "npm --prefix backend run prisma:generate && npm --prefix backend run check",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:migrate": "npm --prefix backend run prisma:migrate",
    "prisma:deploy": "npm --prefix backend run prisma:deploy",
    "prisma:studio": "npm --prefix backend run studio",
    "catalogo:cidades": "node scripts/atualizar-municipios-ibge.mjs",
    "catalogo:escolas": "node scripts/atualizar-escolas-inep.mjs",
    "install:all": "node scripts/install-all.cjs",
    "shortcuts": "node scripts/workspace-runner.cjs help"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,json,md,yml,yaml,css}": "prettier --write",
    "frontend/**/*.{js,jsx}": "npm --prefix frontend exec -- eslint --fix --config frontend/eslint.config.js",
    "backend/**/*.js": "npm --prefix backend exec -- eslint --fix --config backend/eslint.config.js"
  },
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10"
  }
}
