# Endereco em que o frontend sera publicado.
# Use 127.0.0.1 para acesso somente local ou 0.0.0.0 para a rede interna.
SERVER_BIND_ADDRESS=127.0.0.1

# Porta publicada no computador servidor. Use 80 para acessar sem ":8080".
SERVER_PORT=8080

# Origem exata usada pelos navegadores, sem barra no final.
CORS_ORIGINS=http://localhost:8080

# Planilha publica usada somente para importar novas versoes de perguntas.
PERGUNTAS_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vTsNj_z-lz_htrzuv0pbyFllv_z2cFNeRRvX-GUV2RPUEsx08TfUoSS24LjXZS3OML3O1f_yW-e-E6t/pub?output=csv
PERGUNTAS_TIMEOUT_MS=10000

# Gere valores aleatorios e diferentes para cada segredo.
QUIZ_CONTEXT_SECRET=substitua-por-um-segredo-aleatorio
PERGUNTAS_ADMIN_TOKEN=substitua-por-outro-segredo-aleatorio

# Quantidade de dias de backups locais preservados.
BACKUP_RETENTION_DAYS=30
