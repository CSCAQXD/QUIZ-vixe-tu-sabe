generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Escola {
  id        String    @id @default(uuid())
  nome      String
  cidade    String
  partidas Partida[]

  @@unique([nome, cidade])
  @@index([nome])
}

model Partida {
  id             String         @id @default(uuid())
  idempotencyKey String         @unique
  pontuacaoFinal Int
  ano            Int
  dataPartida    DateTime       @default(now())
  escolaId       String
  escola         Escola         @relation(fields: [escolaId], references: [id])
  participacoes  Participacao[]

  @@index([escolaId])
  @@index([ano])
  @@index([escolaId, ano])
  @@index([dataPartida])
}

model Participacao {
  id        String  @id @default(uuid())
  serie     Int
  turma     String
  partidaId String
  partida   Partida @relation(fields: [partidaId], references: [id], onDelete: Cascade)

  @@unique([partidaId, serie, turma])
  @@index([partidaId])
  @@index([serie, turma])
}