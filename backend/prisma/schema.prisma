generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Escola {
  id        String    @id @default(uuid())
  nome      String
  cidade    String
  nomeBusca String?
  cidadeBusca String?
  partidas Partida[]
  cursos   Curso[]

  @@unique([nome, cidade])
  @@unique([nomeBusca, cidadeBusca])
  @@index([nome])
}

model Curso {
  id            String          @id @default(uuid())
  nome          String
  nomeBusca     String
  escolaId      String
  escola        Escola          @relation(fields: [escolaId], references: [id], onDelete: Cascade)
  participacoes Participacao[]

  @@unique([escolaId, nomeBusca])
  @@index([escolaId])
}

model Partida {
  id             String         @id @default(uuid())
  idempotencyKey String         @unique
  pontuacaoFinal Int
  ano            Int
  dataPartida    DateTime       @default(now())
  escolaId       String
  escola         Escola         @relation(fields: [escolaId], references: [id])
  participacoes  Participacao[]

  @@index([escolaId])
  @@index([ano])
  @@index([escolaId, ano])
  @@index([dataPartida])
}

model Participacao {
  id          String  @id @default(uuid())
  etapaEnsino String  @default("FUNDAMENTAL")
  serie       Int
  turma       String
  cursoId     String?
  curso       Curso?  @relation(fields: [cursoId], references: [id])
  partidaId   String
  partida     Partida @relation(fields: [partidaId], references: [id], onDelete: Cascade)

  @@unique([partidaId, etapaEnsino, serie, turma])
  @@index([partidaId])
  @@index([etapaEnsino, serie, turma])
}
