{
  "name": "backend",
  "version": "2.0.0",
  "description": "API do Quiz Interativo da Casa de Saberes Cego Aderaldo",
  "main": "index.js",
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
    "test": "node --test --test-concurrency=1",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=**/*.js --test-coverage-exclude=test/** --test-coverage-exclude=node_modules/** --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80",
    "lint": "eslint . --max-warnings=0",
    "check": "node --check index.js && prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "studio": "prisma studio"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Carla Cristina Sousa Araújo",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "axios": "^1.16.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "papaparse": "^5.7.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prisma": "7.10.1"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/client@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
