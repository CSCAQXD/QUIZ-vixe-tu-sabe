# Caminho do banco SQLite
DATABASE_URL="file:./dev.db"

# Porta da API
PORT=3001

# Ambiente da aplicação
NODE_ENV="development"

# URL pública da planilha exportada como CSV
PERGUNTAS_CSV_URL="https://docs.google.com/spreadsheets/d/e/2PACX-1vTsNj_z-lz_htrzuv0pbyFllv_z2cFNeRRvX-GUV2RPUEsx08TfUoSS24LjXZS3OML3O1f_yW-e-E6t/pub?output=csv"

# Tempo máximo da consulta externa, em milissegundos
PERGUNTAS_TIMEOUT_MS=5000

# Duração do cache das perguntas, em milissegundos
PERGUNTAS_CACHE_TTL_MS=300000

# Chave privada do backend para assinar a categoria e as turmas do quiz
# Em produção, use a mesma chave persistente em todas as instâncias
# Gere localmente: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Vazio: chave temporária; reiniciar o backend invalida os quizzes em andamento
QUIZ_CONTEXT_SECRET=""

# Origens permitidas pelo CORS, separadas por vírgula
# Em desenvolvimento, * permite qualquer origem
CORS_ORIGINS="*"

# Quantidade máxima de operações de escrita por janela e duração da janela
WRITE_RATE_LIMIT_MAX=60
WRITE_RATE_LIMIT_WINDOW_MS=60000

# Quantidade de proxies reversos confiáveis entre a internet e a API
# Use 1 quando houver um único proxy; deixe vazio para acesso direto
TRUST_PROXY=""
